@namespace Kodepos
@inherits PosComponentBase

<button id="@Id"
        class="@ClassValue"
        role="switch"
        type="button"
        aria-checked="@Checked"
        aria-required="false"
        data-state="@CheckedValue"
        value="on"
        disabled="@Disabled"
        @onclick=ToggleCheck
        aria-label="Airplane Mode">
    <span data-state="@CheckedValue" class="pointer-events-none block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform data-[state=checked]:translate-x-4 data-[state=unchecked]:translate-x-0"></span>
</button>

@code {
    const string DefaultClasses = "peer inline-flex h-5 w-9 shrink-0 cursor-pointer items-center rounded-full border-2 border-transparent shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:cursor-not-allowed disabled:opacity-50 data-[state=checked]:bg-primary data-[state=unchecked]:bg-input";

    string? ClassValue => new CssBuilder().AddClass(Class).AddClass(DefaultClasses).Build();
    bool _checked;

    [Parameter]
    public bool Checked
    {
        get => _checked; set
        {
            if (value == _checked)
            {
                return;
            }
            _checked = value;
            CheckedChanged.InvokeAsync(value);
        }
    }

    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    string CheckedValue => Checked ? "checked" : "unchecked";

    void ToggleCheck()
    {
        Checked = !Checked;
    }
}