@namespace Kodepos
@inherits PosComponentBase

<svg xmlns="http://www.w3.org/2000/svg"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="@Color"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     class="@Class"
     style="@Style"
     @attributes=Attributes>
     @((MarkupString)Name.ToIconContent())
</svg>
@code {
    [Parameter]
    public int Size { get; set; } = 24;

    [Parameter]
    public string Color { get; set; } = "currentColor";

    [Parameter]
    public IconName Name { get; set; }
}