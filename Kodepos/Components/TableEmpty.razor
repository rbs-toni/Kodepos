@namespace Kodepos
<TableRow>
    <TableCell Class="p-4 whitespace-nowrap align-middle text-sm text-foreground" colspan="@ColSpan">
        <div class="flex items-center justify-center py-10">
            @ChildContent
        </div>
    </TableCell>
</TableRow>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public int ColSpan { get; set; } = 100;
 }