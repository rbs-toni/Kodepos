@namespace Kodepos

<div class="container mx-auto px-4 py-12 md:px-6 lg:py-24 2xl:max-w-[1400px]">
    <div class="text-center">
        <h1 class="mb-4 scroll-m-20 text-4xl font-extrabold tracking-tight lg:text-5xl">Pencarian Kode Pos Indonesia</h1>
        <p class="text-muted-foreground mb-6 text-xl">Jelajahi kode pos dari seluruh wilayah di Indonesia secara cepat dan mudah.</p>
        @ChildContent
    </div>
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
