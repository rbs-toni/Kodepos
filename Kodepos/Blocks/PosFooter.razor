@namespace Kodepos

<footer class="bg-background border-t">
    <div class="container mx-auto px-4 md:px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-y-2">
        <div class="flex flex-wrap items-center gap-x-4 text-muted-foreground text-xs">
            <span class="flex items-center gap-x-1">
                🇮🇩 <span>@DateTime.Now.Year</span>
            </span>
            <span class="hidden sm:inline">•</span>
            <span class="flex items-center gap-x-1">
                Dibangun dengan <strong class="font-semibold text-foreground hover:underline"><a href="https://learn.microsoft.com/en-us/aspnet/core/blazor/?view=aspnetcore-9.0&WT.mc_id=dotnet-35129-website" target="_blank">Blazor</a></strong>
            </span>
            <span class="hidden sm:inline">•</span>
            <span class="flex items-center gap-x-1">
                Disusun dengan <strong class="font-semibold text-foreground hover:underline"><a href="https://tailwindcss.com/" target="_blank">tailwindcss</a></strong>
            </span>
            <span class="hidden sm:inline">•</span>
            <span class="flex items-center gap-x-1">
                Ikon dari <strong class="font-semibold text-foreground hover:underline"><a href="https://lucide.dev/" target="_blank">Lucide</a></strong>
            </span>
        </div>

        <div class="text-muted-foreground text-sm hover:text-foreground transition-colors">
            Dibuat dengan penuh <span class="inline-block animate-pulse">❤️</span>
        </div>
    </div>
</footer>
